rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // A user can read their own profile.
      // Admins can read any user.
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      // Users can update their own profile.
      // Admins can create/update/delete users.
      allow write: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
        );
    }


    // =========================================================
    // TECHNICIANS
    // =========================================================

    match /technicians/{technicianId} {

      // Only admins can view technicians.
      allow read: if isAdmin();

      // Only admins can create technicians.
      allow create: if isAdmin();

      // Only admins can update technicians.
      allow update: if isAdmin();

      // Only admins can delete technicians.
      allow delete: if isAdmin();
    }


    // =========================================================
    // ICT ISSUES
    // =========================================================

    match /issues/{issueId} {

      // -------------------------------------------------------
      // PUBLIC ISSUE SUBMISSION
      // -------------------------------------------------------
      //
      // Anyone can create a new ICT issue.
      //
      allow create: if true;


      // -------------------------------------------------------
      // PUBLIC TICKET LOOKUP
      // -------------------------------------------------------
      //
      // The Track Status page currently searches by ticketId.
      //
      // IMPORTANT:
      // This allows reading individual issue documents.
      // See security note below.
      //
      allow get: if true;


      // -------------------------------------------------------
      // ADMIN LIST
      // -------------------------------------------------------
      //
      // Admin dashboard can retrieve all issues.
      //
      allow list: if isAdmin();


      // -------------------------------------------------------
      // ADMIN UPDATE
      // -------------------------------------------------------
      //
      // Assignment, status changes, reports, admin notes, etc.
      //
      allow update: if isAdmin();


      // -------------------------------------------------------
      // ADMIN DELETE
      // -------------------------------------------------------
      //
      allow delete: if isAdmin();
    }


    // =========================================================
    // TICKET COUNTER
    // =========================================================

    match /counters/{counterId} {

      // Keep this only if your application actually uses
      // this collection from the client.
      //
      // For better security, this should eventually be moved
      // behind a Cloud Function.
      //
      allow get, write: if true;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

