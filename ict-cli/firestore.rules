rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // AUTH HELPERS
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.admin == true;
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {
      // Users can access their own profile.
      // Admins can access all user profiles.
      allow read: if isSignedIn() &&
                  (request.auth.uid == userId || isAdmin());

      // Users can update their own profile.
      // Admins can create/update/delete any profile.
      allow write: if isAdmin() ||
                   (isSignedIn() && request.auth.uid == userId);
    }


    // =========================
    // REPORT ISSUES / ICT TICKETS
    // =========================
    //
    // Collection used by the Angular application:
    // /report-issue/{ticketId}
    //
    // Public users:
    //   - Can create a new issue.
    //   - Can read a single issue when they know its ID.
    //
    // Admins:
    //   - Can list all issues.
    //   - Can create issues.
    //   - Can read/update/delete issues.
    //

    match /report-issue/{ticketId} {

      // Track a specific ticket.
      allow get: if true;

      // Admin dashboard can load all tickets.
      allow list: if isAdmin();

      // Public issue submission.
      allow create: if true;

      // Admins can modify or delete tickets.
      allow update, delete: if isAdmin();
    }


    // =========================
    // TICKET COUNTER
    // =========================
    //
    // Used by IssueService for generating ticket numbers.
    //

    match /counters/{counterId} {
      allow get, write: if true;
    }


    // =========================
    // DEFAULT DENY
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}